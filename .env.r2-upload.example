# Cloudflare R2 Upload Configuration
# For product image uploads in admin panel
# Date: 2026-06-10

# R2 Account and Bucket
R2_ACCOUNT_ID=your_account_id_here
R2_BUCKET_NAME=sparkstage-public-assets

# R2 API Credentials (for upload presigned URLs)
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# R2 Endpoints
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.sparkstage55.com

# Upload Configuration
R2_MAX_FILE_SIZE=10485760
R2_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.r2-upload
# 2. Get R2 credentials from Cloudflare Dashboard → R2 → Settings
# 3. Add these to .env.local for local development
# 4. Add to Supabase Edge Function secrets for production:
#    supabase secrets set R2_ACCESS_KEY_ID=xxx R2_SECRET_ACCESS_KEY=xxx
# 5. NEVER commit .env.r2-upload to git!
